{$DOMAIN} {
	encode gzip
	# These apply to every response: the app, /api/* and the public pages.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Svelte transitions inject inline styles, hence 'unsafe-inline' for styles only.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
	handle /api/* {
		# Every API payload is small (the largest, a 25-contact Claude batch, is well under this).
		request_body {
			max_size 5MB
		}
		reverse_proxy backend:8000
	}
	handle {
		root * /srv
		# The public pages fill in CONTACT_EMAIL when served (spec §4.5). Templates run on
		# these two files only, never on the app's own files.
		@public_pages path /about.html /privacy.html
		templates @public_pages
		file_server
	}
}
