# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env && chmod 600 .env
# Server setup, step by step: docs/deploy/server-setup.md
#
# Each secret below has two ways to generate it. The openssl command works on a stock Mac
# and on the Ubuntu server; the python one needs Python with the cryptography package.

# Public hostname Caddy serves (automatic HTTPS): just the name, no https:// and no slash.
# Use localhost for a local copy on your Mac or PC.
DOMAIN=tracker.example.com

# Your email, shown on the public /about.html and /privacy.html pages. Required for publishing
# the Google app (Google asks for a contact). Left empty, the pages say "the site owner".
CONTACT_EMAIL=

# Database container credentials. Keep consistent with DATABASE_URL below.
# Generate the password: openssl rand -hex 16
#   (put the same value in DATABASE_URL below, in place of change-me-db-password)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=internship_tracker

# The host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://app:change-me-db-password@db:5432/internship_tracker

# REQUIRED: replace the change-me placeholders below. The backend refuses to start with a
# placeholder or a JWT_SECRET shorter than 32 bytes, or with an invalid TOKEN_ENCRYPTION_KEY.
# Generate: openssl rand -hex 48
#       or: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
# Fernet key. It encrypts your authenticator secret and Google token in the database: keep it
# for good, and copy it verbatim when moving servers (README, "Moving to a new server").
# Generate: openssl rand -base64 32 | tr '+/' '-_'
#       or: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me

# Optional: a second Fernet key, different from TOKEN_ENCRYPTION_KEY (generate it the same way).
# Setting it turns on the encrypted copy of each nightly backup in Google Drive; left empty,
# backups stay on the server only. A set-but-invalid key stops the backend from starting.
# Keep it with .env: without it the Drive copies can't be read.
BACKUP_ENCRYPTION_KEY=

# Google OAuth client (Google Cloud Console). The redirect URI must be listed in the client.
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
# Always https://<DOMAIN>/api/docs/google/callback. Local copies (DOMAIN=localhost) use
# https://localhost/api/docs/google/callback.
GOOGLE_REDIRECT_URI=https://tracker.example.com/api/docs/google/callback

# Keep true in production (HTTPS-only cookies).
COOKIE_SECURE=true

# Local time zone for the scheduled jobs: database backup at 02:30, backup-sheet sync at 03:00.
TZ=America/Chicago
