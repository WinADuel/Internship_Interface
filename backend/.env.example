# Copy this file to .env and fill in real values for local development.

# Primary application database (used by Settings / Alembic outside of tests).
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/internship_tracker

# Database used exclusively by the pytest harness (backend/tests/conftest.py).
TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/internship_tracker_test

# Auth / crypto secrets. Generate real random values for anything beyond local dev.
JWT_SECRET=change-me
TOKEN_ENCRYPTION_KEY=change-me

# Google OAuth (Docs linking, Phase 1 feature). Fill in from Google Cloud Console.
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URI=http://localhost:8000/api/docs/oauth/callback
